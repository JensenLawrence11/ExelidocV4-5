{
  "manifest_version": 3,
  "name": "Exelidoc",
  "version": "1.2.9",
  "description": "On-demand AI help for Gmail, Docs, Sheets, and Slides.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "733957481846-72v784csg244sum7vrthd2j10cdg29am.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/spreadsheets.readonly",
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": [
    "https://exelidocv4-5.onrender.com/*",
    "https://docs.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/drive/v3/*",
    "https://sheets.googleapis.com/*",
    "https://slides.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/favicon.ico"],
      "matches": ["https://mail.google.com/*", "https://docs.google.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "content-scripts/history-panel.js",
        "content-scripts/gmail-source-picker.js",
        "content-scripts/gmail.js"
      ],
      "css": ["content-scripts/exelidoc-panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": [
        "content-scripts/history-panel.js",
        "content-scripts/gmail-source-picker.js",
        "content-scripts/gdocs.js"
      ],
      "css": ["content-scripts/exelidoc-panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": [
        "content-scripts/history-panel.js",
        "content-scripts/gmail-source-picker.js",
        "content-scripts/gsheets.js"
      ],
      "css": ["content-scripts/exelidoc-panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["content-scripts/history-panel.js", "content-scripts/slides.js"],
      "css": ["content-scripts/exelidoc-panel.css"],
      "run_at": "document_idle"
    }
  ]
}
