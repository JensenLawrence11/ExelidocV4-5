# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file.

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FRONTEND_ORIGINS=exelidoc.netlify.app

# --- AI provider ---
# Pick whichever you're using; the backend only needs the one(s) you enable.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxx
MISTRAL_API_KEY=your-mistral-key-here
MISTRAL_MODEL=mistral-small-latest

# --- Stripe ---
# Free tier never touches Stripe -- only create prices for Pro and Enterprise.
# Use an API key, active recurring Price IDs, and webhook secret from the same
# Stripe account and test/live mode. Price IDs start with price_, not prod_.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxxxxxx

# --- Supabase ---
# Project Settings -> API in your Supabase dashboard.
# Use the service_role key here (server-side only) -- NOT the anon/public key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxx

# --- Transactional email (SMTP) ---
# Use your email provider's SMTP credentials and a verified sender address.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-smtp-username
EMAIL_SMTP_PASSWORD=your-smtp-password
EMAIL_FROM_ADDRESS=accounts@example.com
EMAIL_FROM_NAME=Exelidoc
